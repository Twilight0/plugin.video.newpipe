msgid "Direct playback maximum resolution"
msgstr "Μέγιστη ανάλυση άμεσης αναπαραγωγής"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Χρησιμοποιεί μία άμεση ροή ήχου/βίντεο και αποφεύγει τον προβληματικό διαμεσολαβητή DASH."

msgctxt "#30039"
msgid "Fast start"
msgstr "Γρήγορη εκκίνηση"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Προτίμησε άμεση ροή 360p/480p όταν υπάρχει. Απενεργοποίησέ το για προτίμηση της υψηλότερης επιλεγμένης ανάλυσης."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Προσαρμοσμένος κωδικός χώρας (προαιρετικά)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Εισάγετε οποιονδήποτε διγράμματο κωδικό χώρας ISO 3166-1. Παρακάμπτει την επιλογή χώρας."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Προσαρμοσμένος κωδικός γλώσσας (προαιρετικά)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Εισάγετε κωδικό γλώσσας YouTube όπως pt, pt-PT, en ή es. Παρακάμπτει την επιλογή γλώσσας."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Επιλέξτε τη χώρα που χρησιμοποιεί το YouTube για την τοπικοποίηση αποτελεσμάτων."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Επιλέξτε τη γλώσσα που χρησιμοποιεί το YouTube για την τοπικοποίηση τίτλων και αποτελεσμάτων."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Προεπιλεγμένη κατηγορία Δημοφιλών"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Επιλέξτε την κατηγορία που ανοίγει αμέσως με την επιλογή Δημοφιλή."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Προεπιλεγμένη κατηγορία Ζωντανών"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Επιλέξτε την κατηγορία που ανοίγει αμέσως με την επιλογή Ζωντανά."

msgctxt "#30051"
msgid "Trailers"
msgstr "Τρέιλερ"

msgctxt "#30052"
msgid "Trailer language/version"
msgstr "Γλώσσα/έκδοση τρέιλερ"

msgctxt "#30053"
msgid "Choose how trailers are searched. This is independent of the selected content country."
msgstr "Επιλέξτε πώς αναζητούνται τα τρέιλερ. Είναι ανεξάρτητο από την επιλεγμένη χώρα περιεχομένου."

msgctxt "#30054"
msgid "Trailer maximum resolution"
msgstr "Μέγιστη ανάλυση τρέιλερ"

msgctxt "#30055"
msgid "Choose the resolution requested for trailers. 4K depends on availability, device decoding and InputStream Adaptive settings."
msgstr "Επιλέξτε την ανάλυση που ζητείται για τρέιλερ. Το 4K εξαρτάται από διαθεσιμότητα, αποκωδικοποίηση συσκευής και ρυθμίσεις InputStream Adaptive."

